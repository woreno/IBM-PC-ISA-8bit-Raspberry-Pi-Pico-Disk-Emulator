Name       ATF_MEM;
Date       28/9/26;
Revision   1;
Designer   Moreno;
Device     g16v8as; /* ATF16V8B - simple*/
Pin 1    = MEMW_;
Pin 2    = MEMR_;
Pin 3    = A19;       
Pin 4    = A18;
Pin 5    = A17;     
Pin 6    = A16;     
Pin 7    = A15;



/* saidas */
Pin 17   = MEM_READ_EN;
Pin 16   = MEM_WRITE_EN;



Pin 15   = d;   
Pin 14   = c;  
Pin 13   = b;  
Pin 12   = a; 

a = A19 & A18;
b = A19 & A18 & !A17;
c = A19 & A18 & !A17 & !A16;
d = MEM_EN;

MEM_EN =  A19 & A18 & !A17 & !A16 & A15 ;

MEM_EN2 =  A19 & A18 & !A17 & !A16 & !A15 ;

/* logica positiva */
MEM_READ_EN =  (!MEMR_ & MEMW_  & MEM_EN);  

MEM_WRITE_EN =  (!MEMW_  & MEMR_ & MEM_EN);  


%SIGNAL
PIN   7 =  A15 
PIN   6 =  A16 
PIN   5 =  A17 
PIN   4 =  A18 
PIN   3 =  A19 
PIN   2 =  MEMR_ 
PIN   1 =  MEMW_ 
PIN  17 =  MEM_READ_EN 
PIN  16 =  MEM_WRITE_EN 
PIN  12 =  a 
PIN  13 =  b 
PIN  14 =  c 
PIN  15 =  d 
%END

%FIELD
%END

%EQUATION
MEM_EN =>
    A15 & !A16 & !A17 & A18 & A19

MEM_EN2 =>
    !A15 & !A16 & !A17 & A18 & A19

MEM_READ_EN =>
    A15 & !A16 & !A17 & A18 & A19 & !MEMR_ & MEMW_

MEM_WRITE_EN =>
    A15 & !A16 & !A17 & A18 & A19 & MEMR_ & !MEMW_

a =>
    A18 & A19

b =>
    !A17 & A18 & A19

c =>
    !A16 & !A17 & A18 & A19

d =>
    A15 & !A16 & !A17 & A18 & A19

